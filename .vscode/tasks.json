{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-backend",
      "type": "shell",
      "command": "go build ./...",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "problemMatcher": "$go",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test-backend",
      "type": "shell",
      "command": "go test ./...",
      "options": {
        "cwd": "${workspaceFolder}/api"
      },
      "problemMatcher": "$go"
    },
    {
      "label": "build-frontend",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/src/Luxus.Connect.Web"
      },
      "problemMatcher": []
    },
    {
      "label": "docker-down",
      "type": "shell",
      "command": "./docker-down.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "docker-up",
      "type": "shell",
      "command": "./docker-up.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
