      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2720,
        40
      ],
      "parameters": {
        "jsCode": "const binary = $input.first().binary || {};\nconst file = binary.data || Object.values(binary)[0];\nif (!file) {\n  return [{ json: { skipPdf: true } }];\n}\nconst buf = await this.helpers.getBinaryDataBuffer(0, file.fileName ? 'data' : Object.keys(binary)[0]);\nconst b64 = buf.toString('base64');\nconst prep = $('Preparar envio').item.json;\nreturn [{ json: { skipPdf: false, media: b64, phone: prep.phone, instance: prep.instance, fileName: 'boleto-' + prep.boletoId + '.pdf' } }];"
      }
