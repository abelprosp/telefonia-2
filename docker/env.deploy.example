# Copie para .env na raiz do repositório na VPS (ou mescle com o .env existente).
# Usado por docker-compose.prod.yml — não commite segredos.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Nome da base de dados. Mantenha luxus_connect_dev para reutilizar volumes já criados;
# para renomear numa base existente, faça primeiro ALTER DATABASE.
POSTGRES_DB=luxus_connect_dev

SEQ_PWD_HASH=

AUTH_SECRET=
# Gere automaticamente com python3 scripts/configure-local-auth.py.

RMQ_USER=guest
RMQ_PWD=guest


OBJECT_STORAGE_SERVICE_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET_NAME=luxus-connect

# HTTPS público, sem barra final. Credenciais de aplicação distintas do root.
PUBLIC_ORIGIN=https://telefonia.redobrai.online
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Fixe as imagens verificadas por digest, incluindo os patches de segurança.
# Exemplo de formato: registry/imagem@sha256:<64 caracteres hexadecimais>
# Recuperação com cache local: python3 scripts/pin-local-images.py
# IDs locais sha256:<64 hex> não são digests de manifestos do registry.
POSTGRES_IMAGE=
RABBITMQ_IMAGE=
MINIO_IMAGE=
MINIO_MC_IMAGE=

# Integrações opcionais
# Recebimento de clientes/vendas. Mesma chave no remetente; organização fixada aqui.
TELEFONIA_INTAKE_API_KEY=
TELEFONIA_INTAKE_ORG_ID=
ZAPSIGN_API_TOKEN=
ZAPSIGN_BASE_URL=
ZAPSIGN_WEBHOOK_TOKEN=
SICREDI_WEBHOOK_TOKEN=

# Entrada das vendas concluídas do Luxus Parceiros.
# A chave precisa ser a mesma de TELEFONIA_INTAKE_API_KEY no Parceiros.
PARCEIROS_INTAKE_API_KEY=
PARCEIROS_INTAKE_ORG_ID=

# Opcional
# TAG=latest
