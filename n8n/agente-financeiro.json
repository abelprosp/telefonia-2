    {
      "id": "code-reply",
      "name": "Preparar envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        140
      ],
      "parameters": {
        "jsCode": "const out = $input.first().json;\nlet text = out.output || out.text || out.message || '';\nif (typeof text !== 'string') text = JSON.stringify(text);\nconst match = text.match(/\\[\\[BOLETO:([0-9a-fA-F-]{8,})\\]\\]/);\ntext = text.replace(/\\s*\\[\\[BOLETO:[^\\]]+\\]\\]\\s*/g, '').trim();\nif (!text) text = 'Não consegui consultar agora. Pode repetir seu nome ou CPF?';\nconst phone = $('Normalizar WhatsApp').item.json.phone;\nconst instance = $('Normalizar WhatsApp').item.json.instance || $env.EVOLUTION_INSTANCE;\nreturn [{ json: { text, phone, instance, boletoId: match ? match[1] : '', hasBoleto: Boolean(match) } }];"
      }
    },
